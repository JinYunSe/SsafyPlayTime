# ═══════════════════════════════════════════
# 🥊 래그돌 멀티플레이어 배틀 — 환경 변수 템플릿
# 이 파일을 복사해서 .env로 만들고 실제 값을 넣으세요
# cp .env.example .env
# ⚠️ .env 파일은 절대 Git에 커밋하지 마세요!
# ═══════════════════════════════════════════

# ─── MySQL ───
DB_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_db_password_here
DB_URL=jdbc:mysql://db:3306/ragdolldb?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=gameuser

# ─── Redis ───
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ───
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long
JWT_EXPIRATION=3600000

# ─── Spring ───
SPRING_PROFILES_ACTIVE=local

# ─── Server ───
SERVER_PORT=8080
