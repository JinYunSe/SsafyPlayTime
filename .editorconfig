# ═══════════════════════════════════════════
# .editorconfig — 프로젝트 루트에 배치
# 모든 IDE (VS, Rider, IntelliJ, VSCode)에서 자동 적용
# ═══════════════════════════════════════════

# 최상위 editorconfig
root = true

# ─── 모든 파일 공통 ───
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# ─── C# (Unity 클라이언트) ───
[*.cs]
indent_size = 4

# 중괄호: Allman 스타일 (새 줄에서 시작)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# 들여쓰기
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# 공백
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

# 정렬
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# var 사용 선호도
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 네이밍 규칙 (Roslyn)
dotnet_naming_rule.private_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

# using 정렬
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# this. 선호도
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ─── Java (Spring Boot 서버) ───
[*.java]
indent_size = 4
# Java는 K&R 스타일 (같은 줄에 중괄호)
# → IDE 기본 설정 사용

# ─── Kotlin (혹시 사용 시) ───
[*.kt]
indent_size = 4

# ─── XML (Spring 설정, Android) ───
[*.xml]
indent_size = 4

# ─── JSON ───
[*.json]
indent_size = 2

# ─── YAML (Docker Compose, Spring 설정) ───
[*.{yml,yaml}]
indent_size = 2

# ─── Markdown ───
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ─── Shell Script ───
[*.sh]
indent_size = 2
end_of_line = lf

# ─── Dockerfile ───
[Dockerfile*]
indent_size = 4

# ─── Gradle ───
[*.gradle]
indent_size = 4

[*.gradle.kts]
indent_size = 4

# ─── Properties ───
[*.properties]
indent_size = 4

# ─── Unity 메타 파일 ───
[*.meta]
indent_size = 2

# ─── Unity 에셋 파일 ───
[*.{asset,prefab,unity,anim,controller,overrideController}]
indent_size = 2

# ─── SQL ───
[*.sql]
indent_size = 2

# ─── gitignore 등 ───
[.gitignore]
insert_final_newline = true

# ─── Makefile (탭 필수!) ───
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
