  statusRoomListUiNotBound: "\uBC29 \uBAA9\uB85D UI \uCC38\uC870\uAC00 \uC5F0\uACB0\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusNoRooms: "\uD604\uC7AC \uCC38\uC5EC \uAC00\uB2A5\uD55C \uBC29\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  statusSelectRoom: "\uC785\uC7A5\uD560 \uBC29\uC744 \uC120\uD0DD\uD558\uC138\uC694."
  statusRoomNotFound: "\uBC29\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uBAA9\uB85D\uC744 \uC0C8\uB85C\uACE0\uCE68\uD558\uC138\uC694."
