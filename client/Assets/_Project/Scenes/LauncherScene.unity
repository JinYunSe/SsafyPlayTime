  statusRefreshingRooms: "\uBC29 \uBAA9\uB85D\uC744 \uC0C8\uB85C\uACE0\uCE68 \uC911\uC785\uB2C8\uB2E4..."
  statusNetworkLobbyFailed: "\uB124\uD2B8\uC6CC\uD06C \uB85C\uBE44 \uC5F0\uACB0\uC5D0
    \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  statusRoomListUiNotBound: "\uBC29 \uBAA9\uB85D UI \uCC38\uC870\uAC00 \uC5F0\uACB0\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusNoRooms: "\uD604\uC7AC \uCC38\uC5EC \uAC00\uB2A5\uD55C \uBC29\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  statusSelectRoom: "\uC785\uC7A5\uD560 \uBC29\uC744 \uC120\uD0DD\uD558\uC138\uC694."
  statusRoomNotFound: "\uBC29\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uBAA9\uB85D\uC744 \uC0C8\uB85C\uACE0\uCE68\uD558\uC138\uC694."
  statusRunnerInitFailed: "\uB124\uD2B8\uC6CC\uD06C \uB7EC\uB108 \uCD08\uAE30\uD654\uC5D0
    \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  statusRunnerNotReady: "\uB124\uD2B8\uC6CC\uD06C \uB7EC\uB108\uAC00 \uC900\uBE44\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusOnlyHostCanStart: "\uD638\uC2A4\uD2B8\uB9CC \uAC8C\uC784\uC744 \uC2DC\uC791\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  statusSessionNotReady: "\uC138\uC158\uC774 \uC544\uC9C1 \uC900\uBE44\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusNeedTwoPlayers: "\uAC8C\uC784 \uC2DC\uC791\uC5D0\uB294 \uCD5C\uC18C 2\uBA85\uC774
    \uD544\uC694\uD569\uB2C8\uB2E4."
  statusStartRequestedNoScene: "\uAC8C\uC784 \uC2DC\uC791 \uC694\uCCAD\uB428 (\uAC8C\uC784
    \uC52C\uC774 \uC124\uC815\uB418\uC9C0 \uC54A\uC74C)"
  statusHostCanStartWithF5: "\uD638\uC2A4\uD2B8\uB294 F5\uB85C \uAC8C\uC784\uC744
    \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  statusConnectedFormat: "\uC5F0\uACB0\uB428 ({0}/{1}/{2}) - \uC785\uC7A5\uD560 \uBC29\uC744
    \uC120\uD0DD\uD558\uC138\uC694."
