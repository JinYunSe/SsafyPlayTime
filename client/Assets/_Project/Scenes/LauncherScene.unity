  statusRoomJoinFailedFormat: "\uBC29 \uC785\uC7A5 \uC2E4\uD328: {0}"
  statusRoomCreateFailedFormat: "\uBC29 \uC0DD\uC131 \uC2E4\uD328: {0}"
