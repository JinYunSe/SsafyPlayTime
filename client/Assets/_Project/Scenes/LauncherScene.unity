    \uBAA9\uB85D\uC744 \uC0C8\uB85C\uACE0\uCE68\uD558\uC138\uC694."
  statusRunnerInitFailed: "\uB124\uD2B8\uC6CC\uD06C \uB7EC\uB108 \uCD08\uAE30\uD654\uC5D0
    \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  statusRunnerNotReady: "\uB124\uD2B8\uC6CC\uD06C \uB7EC\uB108\uAC00 \uC900\uBE44\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusOnlyHostCanStart: "\uD638\uC2A4\uD2B8\uB9CC \uAC8C\uC784\uC744 \uC2DC\uC791\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  statusSessionNotReady: "\uC138\uC158\uC774 \uC544\uC9C1 \uC900\uBE44\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  statusNeedTwoPlayers: "\uAC8C\uC784 \uC2DC\uC791\uC5D0\uB294 \uCD5C\uC18C 2\uBA85\uC774
    \uD544\uC694\uD569\uB2C8\uB2E4."
  statusStartRequestedNoScene: "\uAC8C\uC784 \uC2DC\uC791 \uC694\uCCAD\uB428 (\uAC8C\uC784
    \uC52C\uC774 \uC124\uC815\uB418\uC9C0 \uC54A\uC74C)"
  statusHostCanStartWithF5: "\uD638\uC2A4\uD2B8\uB294 F5\uB85C \uAC8C\uC784\uC744
    \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  statusConnectedFormat: "\uC5F0\uACB0\uB428 ({0}/{1}/{2}) - \uC785\uC7A5\uD560 \uBC29\uC744
    \uC120\uD0DD\uD558\uC138\uC694."
  statusLobbyConnectFailedFormat: "\uB85C\uBE44 \uC5F0\uACB0 \uC2E4\uD328: {0}"
  statusRoomJoinFailedFormat: "\uBC29 \uC785\uC7A5 \uC2E4\uD328: {0}"
  statusRoomCreateFailedFormat: "\uBC29 \uC0DD\uC131 \uC2E4\uD328: {0}"
  statusStartGameFailedFormat: "\uAC8C\uC784 \uC2DC\uC791 \uC2E4\uD328: {0}"
  statusRoomsUpdatedFormat: "\uBC29 \uBAA9\uB85D \uC5C5\uB370\uC774\uD2B8: {0}\uAC1C"
  statusDisconnectedFormat: "\uC5F0\uACB0 \uC885\uB8CC: {0}"
  statusHostMigrationInitFailed: "\uD638\uC2A4\uD2B8 \uC774\uAD00 \uC2E4\uD328: \uB7EC\uB108
    \uCD08\uAE30\uD654 \uC2E4\uD328"
  statusHostMigrationFailedFormat: "\uD638\uC2A4\uD2B8 \uC774\uAD00 \uC2E4\uD328:
    {0}"
  validationEnterNickname: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD574\uC8FC\uC138\uC694."
  validationNicknameInUse: "\uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC778 \uB2C9\uB124\uC784\uC785\uB2C8\uB2E4."
  validationNicknameLengthExceeded: "\uB2C9\uB124\uC784\uC740 \uC601\uBB38/\uC22B\uC790
    \uCD5C\uB300 16\uC790, \uD55C\uAE00 \uD3EC\uD568 \uC2DC \uCD5C\uB300 8\uC790\uC785\uB2C8\uB2E4."
  validationEnterRoomName: "\uBC29 \uC774\uB984\uC744 \uC785\uB825\uD574\uC8FC\uC138\uC694."
  validationRoomNameInUse: "\uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC778 \uBC29 \uC774\uB984\uC785\uB2C8\uB2E4."
  validationRoomNameLengthExceeded: "\uBC29 \uC774\uB984\uC740 \uC601\uBB38/\uC22B\uC790
    \uCD5C\uB300 16\uC790, \uD55C\uAE00 \uD3EC\uD568 \uC2DC \uCD5C\uB300 8\uC790\uC785\uB2C8\uB2E4."
  validationPrivatePasswordRequired: "\uBE44\uACF5\uAC1C \uBC29\uC740 \uBE44\uBC00\uBC88\uD638\uAC00
    \uD544\uC694\uD569\uB2C8\uB2E4."
  validationPasswordNumericOnly: "\uBE44\uBC00\uBC88\uD638\uB294 \uC22B\uC790\uB9CC
    \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  validationInvalidPassword: "\uBE44\uBC00\uBC88\uD638\uAC00 \uC62C\uBC14\uB974\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4."
  validationRoomUnavailable: "\uC774\uBBF8 \uC885\uB8CC\uB41C \uBC29\uC785\uB2C8\uB2E4."
